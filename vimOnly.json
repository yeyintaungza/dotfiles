{
  "editor.fontFamily": "JetBrainsMono Nerd Font,JetBrains Mono",
  "editor.lineNumbers": "relative",
  "vim.showMarksInGutter": true,
  "vim.foldfix": true,
  "vim.surround": true,
  "vim.easymotion": true,
  "vim.easymotionKeys": "asdghklqwertyuiopzxcvbnmfj",
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "s",
        "d"
      ],
      "commands": [
        "workbench.panel.markers.view.focus"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "o"
      ],
      "commands": [
        "workbench.action.closeOtherEditors"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "d"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "<C-h>"
      ],
      "after": [
        "<C-W>",
        "h"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "after": [
        "<C-W>",
        "j"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "after": [
        "<C-W>",
        "k"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "after": [
        "<C-W>",
        "l"
      ]
    },
    {
      "before": [
        "<S-h>"
      ],
      "commands": [
        ":bprev"
      ]
    },
    {
      "before": [
        "<S-l>"
      ],
      "commands": [
        ":bnext"
      ]
    },
    {
      "before": [
        "g",
        "d"
      ],
      "commands": [
        "editor.action.revealDefinition"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showDefinitionPreviewHover"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ],
      "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
    },
    {
      "before": [
        "<leader>",
        "c",
        "r"
      ],
      "commands": [
        "editor.action.rename"
      ],
      "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
    }
  ],
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "editor.foldingImportsByDefault": true,
  "window.titleBarStyle": "custom",
  "workbench.colorCustomizations": {
    "editor.background": "#0B1220",
    "sideBar.background": "#080F1C",
    "activityBar.background": "#080F1C",
    "statusBar.background": "#0D1728",
    "titleBar.activeBackground": "#080F1C",
    "panel.background": "#0A1424",
    "terminal.background": "#080F1C",
    "editorGutter.background": "#080F1C",
    "editorLineNumber.foreground": "#34445B",
    "editorLineNumber.activeForeground": "#8296B2",
    "editorGutter.addedBackground": "#294D45",
    "editorGutter.modifiedBackground": "#31547A",
    "editorGutter.deletedBackground": "#5A3440",
    "editorWidget.background": "#101B2D",
    "editorWidget.border": "#263A54",
    "editorSuggestWidget.background": "#101B2D",
    "editorSuggestWidget.border": "#263A54",
    "editorSuggestWidget.selectedBackground": "#1A304B",
    "editorHoverWidget.background": "#101B2D",
    "editorHoverWidget.border": "#263A54",
    "peekViewEditor.background": "#0D1727",
    "peekViewEditor.matchHighlightBackground": "#1C3552",
    "peekViewResult.background": "#0A1424",
    "peekViewResult.selectionBackground": "#1A304B",
    "peekViewTitle.background": "#101B2D",
    "peekView.border": "#304967",
    "menu.background": "#101B2D",
    "menu.selectionBackground": "#1A304B",
    "menu.border": "#263A54",
    "quickInput.background": "#101B2D",
    "quickInput.foreground": "#C4D2E5",
    "scrollbarSlider.background": "#1A2B42",
    "scrollbarSlider.hoverBackground": "#263D5C",
    "scrollbarSlider.activeBackground": "#304A6D",
    "editorGroupHeader.tabsBackground": "#080F1C",
    "tab.activeBackground": "#0B1220",
    "tab.activeForeground": "#C4D2E5",
    "tab.inactiveBackground": "#080F1C",
    "tab.inactiveForeground": "#5C6D84",
    "tab.hoverBackground": "#101B2D",
    "tab.hoverForeground": "#AFC2DA",
    "tab.activeBorderTop": "#5C8FC7",
    "tab.activeBorder": "#263A54",
    "tab.unfocusedActiveBackground": "#0A1424",
    "tab.unfocusedActiveForeground": "#8296B2",
    "tab.unfocusedInactiveBackground": "#080F1C",
    "tab.unfocusedInactiveForeground": "#46566B",
    "tab.border": "#111D2E",
    "editorGroupHeader.tabsBorder": "#111D2E",
    "editorGroupHeader.border": "#111D2E",
    "editor.lineHighlightBackground": "#101B2D",
    "editor.lineHighlightBorder": "#1C3552"
  },
  "git.blame.editorDecoration.enabled": true,
  "editor.accessibilitySupport": "off",
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.minimap.size": "fit",
  "editor.minimap.enabled": false
}
