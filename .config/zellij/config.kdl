theme "kanagawa"
default_mode "locked"
default_layout "custom_layout"
show_startup_tips false

keybinds clear-defaults=true {

    // ─── Locked (home mode) ───────────────────────────────────────
    locked {
        // Mode switching
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Ctrl o" { SwitchToMode "session"; }
        bind "Alt r" "Super r" { SwitchToMode "renametab"; TabNameInput 0; }

        // Pane creation
        bind "Ctrl Shift h" { NewPane "left"; }
        bind "Ctrl Shift j" { NewPane "down"; }
        bind "Ctrl Shift k" { NewPane "up"; }
        bind "Ctrl Shift l" { NewPane "right"; }

        // Pane / tab actions
        bind "Ctrl f"       { ToggleFocusFullscreen; }
        bind "Ctrl q"       { CloseFocus; }
        bind "Ctrl Shift q" { CloseTab; }

        // Floating panes
        bind "Alt f" "Super f" { ToggleFloatingPanes; }

        // Tabs
        bind "Alt i" "Super i"             { GoToPreviousTab; }
        bind "Alt o" "Super o"             { GoToNextTab; }
        bind "Alt Shift n" "Super Shift n" { NewTab; }
        bind "Alt Shift i" "Super Shift i" { MoveTab "left"; }
        bind "Alt Shift o" "Super Shift o" { MoveTab "right"; }

        // Focus
        bind "Alt h" "Super h" { MoveFocus "left"; }
        bind "Alt j" "Super j" { MoveFocus "down"; }
        bind "Alt k" "Super k" { MoveFocus "up"; }
        bind "Alt l" "Super l" { MoveFocus "right"; }

        // Session manager
        bind "Alt s" "Super s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }
    }

    // ─── Normal ───────────────────────────────────────────────────
    normal {
        bind "Ctrl g" "Esc" { SwitchToMode "locked"; }
        bind "Ctrl Shift o"       { SwitchToMode "session"; }
        bind "Ctrl q"       { Quit; }
    }

    // ─── Rename tab ───────────────────────────────────────────────
    renametab {
        bind "Enter"  { SwitchToMode "locked"; }
        bind "Ctrl c" { SwitchToMode "locked"; }
        bind "Esc"    { UndoRenameTab; SwitchToMode "locked"; }
    }

    // ─── Session ──────────────────────────────────────────────────
    session {
        bind "Esc" "Ctrl o" { SwitchToMode "locked"; }
        bind "d"            { Detach; }

        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "a" {
            LaunchOrFocusPlugin "about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }
}

// Plugin aliases — changing these requires a restart
plugins {
    about            location="zellij:about"
    compact-bar      location="zellij:compact-bar"
    configuration    location="zellij:configuration"
    filepicker       location="zellij:strider" {
        cwd "/"
    }
    plugin-manager   location="zellij:plugin-manager"
    session-manager  location="zellij:session-manager"
    status-bar       location="zellij:status-bar"
    strider          location="zellij:strider"
    tab-bar          location="zellij:tab-bar"
    welcome-screen   location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    "file:/Users/zacompany/.dotfiles/.config/zellij/plugins/zjstatus.wasm"
}

web_client {
    font "monospace"
}
